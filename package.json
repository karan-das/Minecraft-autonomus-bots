{
  "name": "ai-bot-minecreaft",
  "version": "1.0.0",
  "description": "AI Minecraft Bot Swarm (Herobrain) + Web Control Dashboard",
  "main": "bot.js",
  "scripts": {
    "start": "node server.js",
    "start:bot": "node --expose-gc --max-old-space-size=4096 bot.js",
    "start:swarm": "node --expose-gc --max-old-space-size=4096 bot.js --swarm 2",
    "start:swarm4": "node --expose-gc --max-old-space-size=4096 bot.js --swarm 4",
    "start:ui": "node --expose-gc --max-old-space-size=4096 bot.js --ui-only",
    "build:ui": "mkdir -p dist && cp dashboard.html dist/index.html",
    "test": "node --check bot.js && node --check skills.js && node --check webui.js && node --check server.js && echo \"ALL SYNTAX OK\""
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "groq-sdk": "^0.13.0",
    "minecraft-data": "^3.119.0",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2"
  }
}
