{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Static dashboard — no install needed'",
  "buildCommand": "mkdir -p dist && cp dashboard.html dist/index.html",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, must-revalidate" }
      ]
    }
  ]
}
